<%- include('./partials/header') %>
    <div class="w-full h-screen flex items-start px-20 py-20 gap-10">
        <!-- Debug information -->
        <div style="position: fixed; top: 10px; right: 10px; background: #f0f0f0; padding: 10px; border: 1px solid #ccc; z-index: 1000; font-size: 12px; max-width: 300px;">
            <strong>Debug Info:</strong><br>
            Cart length: <%= user.cart ? user.cart.length : 'undefined' %><br>
            <% if(user.cart && user.cart.length > 0) { %>
                First item name: <%= user.cart[0].productName || 'undefined' %><br>
                First item price: <%= user.cart[0].productPrice || 'undefined' %><br>
                First item image type: <%= typeof user.cart[0].productImage %><br>
                First item image length: <%= user.cart[0].productImage ? user.cart[0].productImage.length : 'undefined' %><br>
            <% } %>
        </div>
        
        <% if(user.cart && user.cart.length > 0) { %>
            <div class="w-[30%] rounded-md overflow-hidden">
                <div class="w-full h-80 bg-yellow-500 flex items-center justify-center">
                    <% 
                        let mainImageSrc = '';
                        if (user.cart[0].productImage) {
                            if (typeof user.cart[0].productImage === 'string') {
                                // Check if it's already a data URL
                                if (user.cart[0].productImage.startsWith('data:')) {
                                    mainImageSrc = user.cart[0].productImage;
                                } else {
                                    mainImageSrc = 'data:image/jpeg;base64,' + user.cart[0].productImage;
                                }
                            } else if (user.cart[0].productImage.toString && typeof user.cart[0].productImage.toString === 'function') {
                                mainImageSrc = 'data:image/jpeg;base64,' + user.cart[0].productImage.toString('base64');
                            }
                        }
                    %>
                    <% if(mainImageSrc) { %>
                        <img class="h-[12rem]" src="<%= mainImageSrc %>" alt="">
                    <% } else { %>
                        <div class="text-white text-center">
                            <p>Image not available</p>
                        </div>
                    <% } %>
                </div>
                <div class="w-full flex justify-between px-5 py-4">
                    <h3 class="text-2xl"><%= user.cart[0].productName || 'Unknown Product' %></h3>
                    <div class="flex items-center gap-2">
                        <button class="w-7 h-7 bg-white flex rounded-full items-center justify-center ri-add-line"></button>
                        <div class="px-2 py-1 rounded-md bg-white text-black"><%= user.cart[0].quantity || 0 %></div>
                        <button class="w-7 h-7 bg-white flex rounded-full items-center justify-center ri-subtract-line"></button>
                    </div>
                </div>
                <div class="flex items-center justify-between px-5 py-3">
                    <h4 class="text-lg">Net Total</h4>
                    <h2 class="text-lg">₹ <%= (parseFloat(user.cart[0].productPrice) || 0) * (parseInt(user.cart[0].quantity) || 0) %></h2>
                </div>
            </div>
            <div class="w-[70%]">
                <h3 class="text-xl">Cart Items</h3>
                <div class="mt-5 space-y-4">
                    <% user.cart.forEach(function(cartItem) { %>
                        <div class="flex items-center justify-between p-4 border rounded-lg">
                            <div class="flex items-center gap-4">
                                <% 
                                    let imageSrc = '';
                                    if (cartItem.productImage) {
                                        if (typeof cartItem.productImage === 'string') {
                                            // Check if it's already a data URL
                                            if (cartItem.productImage.startsWith('data:')) {
                                                imageSrc = cartItem.productImage;
                                            } else {
                                                imageSrc = 'data:image/jpeg;base64,' + cartItem.productImage;
                                            }
                                        } else if (cartItem.productImage.toString && typeof cartItem.productImage.toString === 'function') {
                                            imageSrc = 'data:image/jpeg;base64,' + cartItem.productImage.toString('base64');
                                        }
                                    }
                                %>
                                <% if(imageSrc) { %>
                                    <img class="w-16 h-16 object-cover rounded" src="<%= imageSrc %>" alt="">
                                <% } else { %>
                                    <div class="w-16 h-16 bg-gray-200 rounded flex items-center justify-center">
                                        <span class="text-gray-500 text-xs">No Image</span>
                                    </div>
                                <% } %>
                                <div>
                                    <h4 class="font-semibold"><%= cartItem.productName || 'Unknown Product' %></h4>
                                    <p class="text-gray-600">₹ <%= cartItem.productPrice || '0' %></p>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                <button class="w-7 h-7 bg-gray-200 flex rounded-full items-center justify-center ri-subtract-line"></button>
                                <span class="px-3 py-1 bg-gray-100 rounded"><%= cartItem.quantity %></span>
                                <button class="w-7 h-7 bg-gray-200 flex rounded-full items-center justify-center ri-add-line"></button>
                                <button class="ml-4 px-3 py-1 bg-red-500 text-white rounded remove-item" data-product-id="<%= cartItem.productId || 'NO_ID' %>" data-debug="<%= JSON.stringify(cartItem) %>">Remove</button>
                            </div>
                        </div>
                    <% }) %>
                </div>
                
                <div class="mt-8">
                    <h3 class="text-xl">Price Breakdown</h3>
                    <div class="px-10 mt-5">
                        <div class="flex mt-2">
                            <h4 class="w-1/3">Total MRP</h4>
                            <h4>₹ <%= user.cart.reduce((total, item) => {
                                const price = parseFloat(item.productPrice) || 0;
                                const qty = parseInt(item.quantity) || 0;
                                return total + (price * qty);
                            }, 0) %></h4>
                        </div>
                        <div class="flex mt-2">
                            <h4 class="w-1/3">Discount on MRP</h4>
                            <h4>₹ 0</h4>
                        </div>
                        <div class="flex mt-2">
                            <h4 class="w-1/3">Platform Fee</h4>
                            <h4>₹ 20</h4>
                        </div>
                        <div class="flex mt-2">
                            <h4 class="w-1/3">Shipping Fee</h4>
                            <h4>FREE</h4>
                        </div>
                    </div>
                    <div class="w-full h-[1px] bg-black mt-10"></div>
                    <div class="flex mt-5">
                        <h3 class="w-1/3 text-xl">Total Amount</h3>
                        <h3 class="font-semibold text-xl text-green-600">₹ <%= user.cart.reduce((total, item) => {
                            const price = parseFloat(item.productPrice) || 0;
                            const qty = parseInt(item.quantity) || 0;
                            return total + (price * qty);
                        }, 0) + 20 %></h3>
                    </div>
                    <div class="flex gap-4 mt-6">
                        <button id="buyNowBtn" class="px-8 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors">
                            Buy Now
                        </button>
                        <a href="/users/orders" class="px-6 py-3 bg-gray-500 text-white rounded-lg hover:bg-gray-600 transition-colors">
                            View Orders
                        </a>
                    </div>
                </div>
            </div>
        <% } else { %>
            <div class="w-full text-center py-20">
                <h2 class="text-2xl text-gray-600">Your cart is empty</h2>
                <a href="/shop" class="mt-4 inline-block px-6 py-3 bg-blue-500 text-white rounded-lg">Continue Shopping</a>
            </div>
        <% } %>
    </div>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const removeButtons = document.querySelectorAll('.remove-item');
            const buyNowBtn = document.getElementById('buyNowBtn');
            
            // Remove item functionality
            removeButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const productId = this.getAttribute('data-product-id');
                    const debugData = this.getAttribute('data-debug');
                    console.log('Removing product:', productId);
                    console.log('Debug data:', debugData);
                    console.log('Button element:', this);
                    
                    if (!productId || productId === 'NO_ID') {
                        alert('Product ID not found. Debug: ' + debugData);
                        return;
                    }
                    
                    fetch(`/users/remove-from-cart/${productId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        }
                    })
                    .then(response => {
                        console.log('Remove response status:', response.status);
                        return response.json();
                    })
                    .then(data => {
                        console.log('Remove response data:', data);
                        if (data.success) {
                            location.reload();
                        } else {
                            alert('Error removing from cart: ' + (data.error || 'Unknown error'));
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('Error removing from cart: ' + error.message);
                    });
                });
            });

            // Buy now functionality
            if (buyNowBtn) {
                buyNowBtn.addEventListener('click', function() {
                    if (confirm('Are you sure you want to buy these items? This will process your purchase and send confirmation emails.')) {
                        buyNowBtn.disabled = true;
                        buyNowBtn.textContent = 'Processing...';
                        
                        fetch('/users/buy', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            }
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                alert(data.message);
                                location.reload();
                            } else {
                                alert('Error: ' + data.error);
                                buyNowBtn.disabled = false;
                                buyNowBtn.textContent = 'Buy Now';
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            alert('Error processing purchase');
                            buyNowBtn.disabled = false;
                            buyNowBtn.textContent = 'Buy Now';
                        });
                    }
                });
            }
        });
    </script>
    
    <%- include('./partials/footer') %>